# DarvishSignal API Configuration
# Copy this file to .env and update the values

# API Base URL (required for DarvishSignal API)
VITE_API_URL=http://localhost:3000

# Google Tag Manager Container ID (format: GTM-XXXXXXX)
VITE_GTM_ID=GTM-XXXXXXX

# Google OAuth Client ID（GCP Console > Credentials > OAuth 2.0 Client ID，Web application）
VITE_GOOGLE_CLIENT_ID=

# AccountService（Google SSO 後端）base URL，例如 https://xxx.up.railway.app
VITE_AUTH_BASE_URL=
