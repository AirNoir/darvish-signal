# dev/staging build：打 Railway 上的 staging API
VITE_API_BASE_URL=https://twstockapi-staging.up.railway.app

# 不開 GTM（避免測試流量打到 production 數據）
VITE_GTM_ID=

# Google OAuth Client ID（GCP Console > Credentials > OAuth 2.0 Client ID，Web application）
VITE_GOOGLE_CLIENT_ID=

# AccountService（Google SSO 後端）base URL
VITE_AUTH_BASE_URL=https://twstockanalysis-accountservice-staging.up.railway.app
