{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darvish-signal",
  "compatibility_date": "2026-04-16",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // 產業地圖目錄的請求先經過 worker.ts 檢查來源（擋直接抓資料檔），其餘靜態檔直接由 Cloudflare 回應
    "run_worker_first": ["/industry-atlas/*", "/leo-atlas/*"]
  },
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }
}
