# 本地開發：透過 Vite proxy 轉發，避免 CORS 問題
VITE_API_BASE_URL=

# Google Tag Manager（本地預設關閉；要本地測 GTM 可填入 GTM-PLKVJ48G）
VITE_GTM_ID=

# Google OAuth Client ID（GCP Console > Credentials > OAuth 2.0 Client ID，Web application）
# 本機開發請放在 .env.local（見 .gitignore *.local）
VITE_GOOGLE_CLIENT_ID=

# AccountService（Google SSO 後端）base URL — 與 VITE_API_BASE_URL 不同服務
VITE_AUTH_BASE_URL=https://twstockanalysis-accountservice-staging.up.railway.app
